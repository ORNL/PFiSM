Main {

   init_time                = 0.0
   init_cycle               = 0
   print_interval           = 1.
   max_steps                = 800
   solution_logging         = FALSE

   relative_tolerance       = 1e-6
   absolute_tolerance       = 1e-6
   max_order                = 2
   uses_preconditioning     = TRUE
   visit_output             = TRUE
}

PFModel {

   // phase-field parameters
   PFM{
      epsilon = 2.
      well_height = 0.25
      mobility = 0.25
      initial_solid_fraction = 0.1
   }

   Temperature{
      initial_value     = 0.7
      // physical diffusion would be ~1.e-3,
      // too fast to allow solidification in 900 steps
      diffusion_coeff   = 1.e-6 // [cm^2/s]
      melting           = 1.
      latent_heat       = 1.
      cp                = 17.
   }

   molar_volume = 1.e-6 // [m^3/mol]

   print_solver_info    = FALSE

   BoundaryConditions {
      Temperature{
         boundary_0 = "slope", "0.0"
         boundary_1 = "slope", "0.0"
         boundary_2 = "slope", "0.0"
         boundary_3 = "slope", "0.0"
         boundary_4 = "slope", "0.0"
         boundary_5 = "value", "0.7"
      }
      Phase{
         boundary_0 = "slope", "0"
         boundary_1 = "slope", "0"
         boundary_2 = "slope", "0"
         boundary_3 = "slope", "0"
         boundary_4 = "value", "1."
         boundary_5 = "value", "0."
      }
   }

}

PhaseFACsolver{
   fac_precond {
      residual_tol         = 1.e-4
   }

   fac_solver{
      //enable_logging = TRUE
   }

   fac_ops{
      //enable_logging = TRUE
      coarse_solver_tolerance      = 1.e-2
   }

   hypre_solver {
      use_smg              = FALSE
      relative_residual_tol = 1.e-2
   }
}

TemperatureFACsolver{
   fac_precond {
      residual_tol         = 1.e-4
   }

   fac_solver{
      //enable_logging = TRUE
   }

   fac_ops{
      //enable_logging = TRUE
      coarse_solver_tolerance      = 1.e-2
   }

   hypre_solver {
      use_smg              = FALSE
      relative_residual_tol = 1.e-2
   }
}

StandardTagAndInitialize{
   tagging_method = "REFINE_BOXES"

   level_0 {
      boxes = [ (0,0,0) , (19,19,19) ]
   }
}

TimerManager {
   timer_list = "PFiSM::*", "solv::*::*"
   print_exclusive = TRUE
}

Geometry {
   domain_boxes  = [ (0,0,0) , (15,15,31) ]
   x_lo          = 0.e0 , 0.e0 , 0.e0 // lower end of computational domain.
   x_up          = 10. , 10. , 20. // upper end of computational domain.
}

PatchHierarchy {
   max_levels              = 1 // Maximum number of levels in hierarchy.

   largest_patch_size {
      level_0 = 16, 16, 16
   }

   smallest_patch_size {
      level_0 = 2 , 2 , 2
   }

}

BergerRigoutsos {
   efficiency_tolerance     = 0.70e0   // min % of tag cells in new patch level
   combine_efficiency       = 0.85e0   // chop box if sum of volumes of smaller
                                       // boxes < efficiency * vol of large box
}

GriddingAlgorithm {
}

LoadBalancer {
}

