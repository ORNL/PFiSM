//See cvode_dir.2d.input for documentation of input specific to this test.


Main {

   init_time                = 0.0
   init_cycle               = 0
   print_interval           = 1.e1
   num_print_intervals      = 1000
   solution_logging         = FALSE

   max_internal_steps       = 1500
   relative_tolerance       = 1e-6
   absolute_tolerance       = 1e-6
// 0=use default
   max_order                = 2
// stepping_method          = timestepping mode for CVODE
    NORMAL                  = 1
    ONESTEP                 = 2
//   stepping_method          = NORMAL
   stepping_method          = ONESTEP
   uses_preconditioning     = TRUE

// Used for testing only
   correct_rhs_evals        = 498
   correct_precond_setups   = 372
   correct_precond_solves   = 246

}

CVODEModel {
   diffusion_value         = 1.0e-5

   print_solver_info    = FALSE

   BoundaryConditions {
      boundary_0 = "slope", "0."
      boundary_1 = "slope", "0."
      boundary_2 = "value", "1."
      boundary_3 = "slope", "2."
      boundary_4 = "slope", "0."
      boundary_5 = "slope", "0."
   }

}

fac_precond {
   max_cycles           = 1
   residual_tol         = 1.e-8
}

fac_solver{
   enable_logging = TRUE
}

fac_ops{
   enable_logging = TRUE
   coarse_solver_tolerance      = 1.e-2
}

hypre_solver {
   use_smg              = FALSE
   relative_residual_tol = 1.e-2
}

StandardTagAndInitialize{
   tagging_method = "REFINE_BOXES"

   level_0 {
      boxes = [ (0,0,0) , (19,19,19) ]
   }
   level_1 {
      boxes = [ (0,0,0) , (39,9,39) ]
   }
   level_2 {
      boxes = [ (0,0,0) , (79,9,79) ]
   }
}

TimerManager {
   timer_list = "apps::main::*"
}

Geometry {
   domain_boxes  = [ (0,0,0) , (19,19,19) ]
   x_lo          = 0.e0 , 0.e0 , 0.e0 // lower end of computational domain.
   x_up          = 1. , 1. , 1. // upper end of computational domain.
}

PatchHierarchy {
   max_levels              = 2 // Maximum number of levels in hierarchy.

// Note: For the following regridding information, data is required for each
//       potential in the patch hierarchy; i.e., levels 0 thru max_levels-1.
//       If more data values than needed are given, only the number required
//       will be read in.  If fewer values are given, an error will result.
//
// Specify coarsening ratios for each level 1 through max_levels-1
   ratio_to_coarser {         // vector ratio to next coarser level
      level_1               = 2 , 2 , 2
      level_2               = 2 , 2 , 2
      level_3               = 2 , 2 , 2
   }

   largest_patch_size {
      level_0 = 16, 16, 16
      // all finer levels will use same values as level_0...
   }

   smallest_patch_size {
      level_0 = 2 , 2 , 2
      // all finer levels will use same values as level_0...
   }

}

BergerRigoutsos {
   efficiency_tolerance     = 0.70e0   // min % of tag cells in new patch level
   combine_efficiency       = 0.85e0   // chop box if sum of volumes of smaller
                                       // boxes < efficiency * vol of large box
}

GriddingAlgorithm {
}

LoadBalancer {
}

