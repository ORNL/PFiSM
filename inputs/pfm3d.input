Main {

   init_time                = 0.0
   init_cycle               = 0
   print_interval           = 100.
   max_steps                = 1000
   solution_logging         = FALSE

   max_internal_steps       = 1500
   relative_tolerance       = 1e-6
   absolute_tolerance       = 1e-6
// 0=use default
   max_order                = 2
   uses_preconditioning     = TRUE
}

PFModel {

   PFM{
      epsilon = 1.77669990185572 // sqrt(6.*delta*L*Gamma/Tm)
      well_height = 0.022017765260778047 // ((eps/delta)**2)/32
      mobility = 1.985e-3 // muk*Tm/(6.*delta*L)
      initial_solid_fraction = 0.05
   }

   Temperature{
      initial_value     = 1000.
      diffusion_coeff   = 1.e-3 // [cm^2/s]
      melting           = 921.12
      latent_heat       = 9.5e3 // rho*L in [J/mol]
      cp                = 2.58e1 // rho*Cp in [J/mol*K]
   }

   molar_volume = 1.e-5 // [m^3/mol]

   print_solver_info    = FALSE

   BoundaryConditions {
      Temperature{
         boundary_0 = "slope", "0.0"
         boundary_1 = "slope", "0.0"
         boundary_2 = "slope", "0.0"
         boundary_3 = "slope", "0.0"
         boundary_4 = "slope", "-1.e-4"
         boundary_5 = "slope", "-1.e-6"
      }
      Phase{
         boundary_0 = "slope", "0"
         boundary_1 = "slope", "0"
         boundary_2 = "slope", "0"
         boundary_3 = "slope", "0"
         boundary_4 = "slope", "0."
         boundary_5 = "slope", "0."
      }
   }

}

PhaseFACsolver{
   fac_precond {
      residual_tol         = 1.e-4
   }

   fac_solver{
      //enable_logging = TRUE
   }

   fac_ops{
      //enable_logging = TRUE
      coarse_solver_tolerance      = 1.e-2
   }

   hypre_solver {
      use_smg              = FALSE
      relative_residual_tol = 1.e-2
   }
}

TemperatureFACsolver{
   fac_precond {
      residual_tol         = 1.e-4
   }

   fac_solver{
      //enable_logging = TRUE
   }

   fac_ops{
      //enable_logging = TRUE
      coarse_solver_tolerance      = 1.e-2
   }

   hypre_solver {
      use_smg              = FALSE
      relative_residual_tol = 1.e-2
   }
}

StandardTagAndInitialize{
   tagging_method = "REFINE_BOXES"

   level_0 {
      boxes = [ (0,0,0) , (19,19,19) ]
   }
   level_1 {
      boxes = [ (0,0,0) , (39,9,39) ]
   }
   level_2 {
      boxes = [ (0,0,0) , (79,9,79) ]
   }
}

TimerManager {
   timer_list = "PFModel::*", "apps::main::*","solv::*::*"
   print_exclusive = TRUE
}

Geometry {
   domain_boxes  = [ (0,0,0) , (29,29,59) ]
   x_lo          = 0.e0 , 0.e0 , 0.e0 // lower end of computational domain.
   x_up          = 90. , 90. , 180. // upper end of computational domain.
}

PatchHierarchy {
   max_levels              = 1 // Maximum number of levels in hierarchy.

// Note: For the following regridding information, data is required for each
//       potential in the patch hierarchy; i.e., levels 0 thru max_levels-1.
//       If more data values than needed are given, only the number required
//       will be read in.  If fewer values are given, an error will result.
//
// Specify coarsening ratios for each level 1 through max_levels-1
   ratio_to_coarser {         // vector ratio to next coarser level
      level_1               = 2 , 2 , 2
      level_2               = 2 , 2 , 2
      level_3               = 2 , 2 , 2
   }

   largest_patch_size {
      level_0 = 16, 16, 16
      // all finer levels will use same values as level_0...
   }

   smallest_patch_size {
      level_0 = 2 , 2 , 2
      // all finer levels will use same values as level_0...
   }

}

BergerRigoutsos {
   efficiency_tolerance     = 0.70e0   // min % of tag cells in new patch level
   combine_efficiency       = 0.85e0   // chop box if sum of volumes of smaller
                                       // boxes < efficiency * vol of large box
}

GriddingAlgorithm {
}

LoadBalancer {
}

