#/bin/csh
module load cray-netcdf
module load cray-hdf5
module load cmake3/3.6.1

cmake -DCMAKE_CXX_COMPILER=CC -DCMAKE_C_COMPILER=cc \
      -DCMAKE_CXX_FLAGS="-Wall -Wextra -std=c++11" \
      -DCMAKE_Fortran_COMPILER=ftn \
      -DSAMRAI_DIR=$HOME/GIT/jeanlucf22/SAMRAI/build_eos \
      -DHYPRE_DIR=$HOME/hypre/hypre-2.11.1/src/hypre_intel \
      -DSUNDIALS_DIR=$HOME/sundials/build_eos \
      -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF ../source

